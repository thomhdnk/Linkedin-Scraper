# Google Search API voor LinkedIn posts
# Gratis account: https://serper.dev (2500 queries/maand gratis)
SERPER_API_KEY=jouw_serper_api_key

# E-mail via Resend (werkt via HTTPS, niet SMTP)
# Gratis account: https://resend.com (3000 emails/maand gratis)
# Voeg je domein toe onder Domains, of gebruik 'onboarding@resend.dev' voor testen
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_TO=jouw@email.nl
EMAIL_FROM=LinkedIn Alerts <alerts@jouwdomein.nl>

# Scheduler tijden (24-uurs notatie, komma-gescheiden)
SCHEDULE_TIMES=08:00,17:00

# Hoeveel uur terug te kijken per run (standaard 12 voor 2x daags)
LOOKBACK_HOURS=12
