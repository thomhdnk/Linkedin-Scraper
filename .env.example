# Google Search API voor LinkedIn posts
# Gratis account: https://serper.dev (2500 queries/maand gratis)
SERPER_API_KEY=jouw_serper_api_key

# Telegram bot notificaties
# 1. Maak een bot via @BotFather in Telegram → /newbot → kopieer het token
# 2. Stuur je bot een bericht in Telegram
# 3. Open /setup-telegram op je Railway URL om je chat ID te vinden
TELEGRAM_TOKEN=123456789:AAFxxx...
TELEGRAM_CHAT_ID=jouw_chat_id

# Scheduler tijden (24-uurs notatie, komma-gescheiden)
SCHEDULE_TIMES=08:00,17:00

# Hoeveel uur terug te kijken per run (standaard 12 voor 2x daags)
LOOKBACK_HOURS=12
